-- {{ header }}
/*
  {{ event.raw_model_name }}.sql
  Raw layer: landing -> raw

  This file is generated. Columns are introspected at gen time. Regenerate
  when the source schema changes.

  Source: {{ event.source.project }}.{{ event.source.dataset }}.{{ event.source.table }}
*/

{{ dbt_config }}

with source as (

    select
        {{ raw_source_cols }}
    from {{ "{{ source('" }}{{ event.source.dataset }}{{ "', '" }}{{ event.source.table }}{{ "') }}" }}

{{ incremental_filter }}

){% if event.raw.dedup %},

deduplicated as (

    select
        {{ raw_dedup_cols }}
        row_number() over (
            partition by {{ event.unique_key | join(', ') }}
            order by {{ event.loaded_at_field }} desc
        ) as _modelgen_rn
    from source

)

select
    {{ raw_final_cols }}
from deduplicated
where _modelgen_rn = 1
{% else %}

select
    {{ raw_final_cols }}
from source
{% endif %}
