# {{ header }}
version: 2

models:
  - name: {{ event.staging_model_name }}
    description: "Consumption Data Product. Stable contract for {{ event.name }}. Casts and renames here absorb upstream schema drift so downstream FDPs do not break."
    config:
{{ yml_config }}
    columns:
{% for col in staging_columns %}
      - name: {{ col.name }}
{% if col.type %}
        data_type: {{ col.type }}
{% endif %}
{% if col.description %}
        description: {{ col.description | yaml_str }}
{% endif %}
{% if col.classification %}
        meta:
          classification: {{ col.classification }}
{% if pseudonymises %}
          pseudonymised: true
{% else %}
          encrypted: true
{% endif %}
{% endif %}
{% if col.tests %}
        tests:
{% for test in col.tests %}
{% if test.args %}
          - {{ test.name }}:
{% for k, v in test.args | dictsort %}
              {{ k }}: {{ v | json }}
{% endfor %}
{% else %}
          - {{ test.name }}
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
{% if snapshot %}
      - name: ds
        data_type: DATE
        description: "Snapshot date. One full copy of the dimension per ds."
        tests:
          - not_null
{% endif %}
