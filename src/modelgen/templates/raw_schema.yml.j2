# {{ header }}
version: 2

sources:
  - name: {{ event.source.dataset }}
{% if source_head %}
{{ source_head }}
{% endif %}
    description: "Landing zone for {{ event.name }}."
    tables:
      - name: {{ event.source.table }}
        description: "Landed {{ event.name }} events. Source schema as observed at gen time."
        loaded_at_field: {{ event.loaded_at_field }}
{% if source_table_extra %}
{{ source_table_extra }}
{% endif %}
{% if freshness %}
        freshness:
{% if freshness.warn_after %}
          warn_after: {count: {{ freshness.warn_after.count }}, period: {{ freshness.warn_after.period }}}
{% endif %}
{% if freshness.error_after %}
          error_after: {count: {{ freshness.error_after.count }}, period: {{ freshness.error_after.period }}}
{% endif %}
{% endif %}
        columns:
{% for col in introspected_columns %}
          - name: {{ col.name }}
            data_type: {{ col.dbt_data_type }}
{% if col.description %}
            description: "{{ col.description | replace('"', '\\"') }}"
{% endif %}
{% endfor %}

models:
  - name: {{ event.raw_model_name }}
    description: "Origin Data Product. {% if event.raw.dedup %}Deduplicated{% else %}Pass-through{% endif %} raw view of {{ event.name }}. Schema mirrors source; new columns flow through."
    config:
{{ yml_config }}
    columns:
{% for col in introspected_columns %}
      - name: {{ col.name }}
        data_type: {{ col.dbt_data_type }}
{% if col.description %}
        description: "{{ col.description | replace('"', '\\"') }}"
{% endif %}
{% endfor %}
